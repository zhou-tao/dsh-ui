{
  "name": "dsh-ui",
  "private": true,
  "version": "0.1.2",
  "description": "deepseek-harness UI layer: Tauri desktop app + VS Code extension (monorepo)",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "smoke": "pnpm --filter @dsh-ui/protocol smoke",
    "test": "turbo run test",
    "plugins:install": "node scripts/install-plugins.mjs",
    "plugins:remove": "node scripts/install-plugins.mjs --remove"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}